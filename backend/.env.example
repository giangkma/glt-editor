PORT=4000
# Origin của frontend Next.js (nhiều origin cách nhau bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000
# Thư mục lưu file tạm
UPLOAD_DIR=uploads
# Giới hạn dung lượng (MB) — 2048 = 2GB
MAX_FILE_SIZE_MB=2048
# File tạm bị xoá sau bao nhiêu giờ (0 = không tự xoá)
UPLOAD_TTL_HOURS=24

# ───────── Auto-Edit ─────────
# Đường dẫn FFmpeg nếu không có trong PATH (vd /opt/homebrew/bin/ffmpeg)
# FFMPEG_PATH=
# FFPROBE_PATH=
OUTPUT_DIR=outputs
TMP_DIR=tmp
EDIT_CONCURRENCY=1

# Cắt khoảng lặng
SILENCE_THRESHOLD_DB=-35
MIN_SILENCE_SEC=0.45
SILENCE_PADDING_SEC=0.12

# Encoder: libx264 (mọi máy) | h264_videotoolbox (Mac — nhanh gấp 5-10 lần) | h264_nvenc (NVIDIA)
VIDEO_ENCODER=libx264
X264_PRESET=medium
X264_CRF=20
HW_BITRATE=45M

# Font phụ đề (có sẵn trên máy, hoặc thả file .ttf vào assets/fonts rồi ghi tên font ở đây)
CAPTION_FONT=Arial

# Chèn text theo giọng nói (OpenAI Whisper). Để trống = bỏ qua bước chèn text
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=vi

# In lệnh FFmpeg đầy đủ ra console để debug
# DEBUG_FFMPEG=1

# ───────── Skill (vd reel-doc-3d) ─────────
# Claude đọc SKILL.md + lời thoại để lên kịch bản edit (chọn đoạn giữ, chia cụm chữ, gán B-roll 3D).
# Để trống → kịch bản tự động đơn giản.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tách phông: rvm (nét) | rvm-nhe (máy yếu, nhanh gấp ~2) | u2net (dự phòng)
SKILL_MATTE=rvm
# Python cho skill — để trống thì tự dùng skills/<tên>/venv
# SKILL_PYTHON=
SKILLS_DIR=skills
PROJECTS_DIR=projects
DATA_DIR=data
# In log của script Python ra console
# DEBUG_SKILL=1

# Tuỳ chọn: Google API key (bật "Google Drive API") — đọc thư mục Drive ổn định hơn, nhiều file hơn.
# Để trống vẫn tải được link file/thư mục công khai.
GOOGLE_API_KEY=
